# Copy this file to .env and replace the example values.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=url_shortener
# Keep false in production; enable only for local development if needed.
DB_SYNCHRONIZE=false

# Generate independent random secrets (at least 32 bytes each) for production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
